rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // Users: each user can read/update their own profile (allows incrementing shopsVisitedCount)
    match /users/{userId} {
      allow read, update, delete: if signedIn() && request.auth.uid == userId;
      allow create: if signedIn() && request.auth.uid == userId;
    }

    // Usernames: one document per lowercased username, so sign-up can check uniqueness
    // without reading other users' profiles. Existing names can't be overwritten (that would be an update).
    match /usernames/{name} {
      allow get: if signedIn();
      allow create: if signedIn()
        && name.matches('^[a-z0-9_]{1,30}$')
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.usernameLower == name;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // Ratings: document id is "<uid>_<shopId>"
    function acceptedFriend(other) {
      let me = request.auth.uid;
      let id = me < other ? me + ':' + other : other + ':' + me;
      return get(/databases/$(database)/documents/friendConnections/$(id)).data.status == 'accepted';
    }

    match /ratings/{ratingId} {
      // Owner can read, update and delete. The id check covers reading a rating that doesn't exist yet.
      allow get, update, delete: if signedIn() &&
        (resource.data.userId == request.auth.uid || ratingId.matches('^' + request.auth.uid + '_.*$'));

      // Friends can read each other's ratings (Feed).
      allow get: if signedIn() && acceptedFriend(resource.data.userId);

      // Lists only of your own ratings (Profile) or accepted friends' ratings (Feed).
      allow list: if signedIn() &&
        (resource.data.userId == request.auth.uid || acceptedFriend(resource.data.userId));

      // Allow creation if the user sets their own userId
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
    }

    // Friends: opt-in directory and connections
    function directoryMatchesProfile(uid, data) {
      let profile = get(/databases/$(database)/documents/users/$(uid)).data;
      return data.keys().hasOnly(['name', 'username', 'usernameLower'])
        && data.name is string && data.name.size() > 0
        && data.username is string && data.username.size() > 0
        && data.usernameLower is string && data.usernameLower.size() > 0
        && data.name == profile.name
        && data.username == profile.username
        && data.usernameLower == profile.usernameLower;
    }

    match /friendDirectory/{uid} {
      allow get: if signedIn();
      allow list: if signedIn() && request.query.limit <= 30;
      allow create, update: if signedIn() && request.auth.uid == uid
        && directoryMatchesProfile(uid, request.resource.data);
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    function participant(data) {
      return signedIn()
        && (data.sender == request.auth.uid || data.recipient == request.auth.uid);
    }

    function matchesDirectory(uid, shared) {
      let directory = get(/databases/$(database)/documents/friendDirectory/$(uid)).data;
      return shared is map && shared.keys().hasOnly(['name', 'username'])
        && shared.name == directory.name && shared.username == directory.username;
    }

    function validNewConnection(id, data) {
      return data.keys().hasOnly(['sender', 'recipient', 'status', 'createdAt', 'senderProfile', 'recipientProfile'])
        && data.sender == request.auth.uid
        && data.sender.matches('[A-Za-z0-9_-]+')
        && data.recipient is string && data.recipient.matches('[A-Za-z0-9_-]+')
        && data.sender != data.recipient
        && id == (data.sender < data.recipient
          ? data.sender + ':' + data.recipient
          : data.recipient + ':' + data.sender)
        && data.status == 'pending' && data.createdAt == request.time
        && matchesDirectory(data.sender, data.senderProfile)
        && matchesDirectory(data.recipient, data.recipientProfile);
    }

    match /friendConnections/{id} {
      allow get, list, delete: if participant(resource.data);
      allow create: if signedIn() && validNewConnection(id, request.resource.data);
      allow update: if signedIn() && resource.data.recipient == request.auth.uid
        && resource.data.status == 'pending' && request.resource.data.status == 'accepted'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
    }

    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
